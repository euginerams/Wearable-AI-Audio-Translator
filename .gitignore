# ---------------------------------------------------------------
# Secrets: never commit Wi-Fi credentials or private configuration
# ---------------------------------------------------------------
firmware/main/wifi_secrets.h
.env
.env.*
!.env.example

# ---------------------------------------------------------------
# ESP-IDF firmware (firmware/)
# ---------------------------------------------------------------
build/
managed_components/
sdkconfig
sdkconfig.old
*.bin
*.elf
*.map
flasher_args.json
CMakePresets.json
CMakePresets.json.bak

# Keep dependencies.lock if present so component versions
# can be reproduced by other developers.

# ---------------------------------------------------------------
# Python server (server/)
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
venv/
.venv/
env/

# Downloaded AI models (do not upload large model weights)
server/models/
server/*.onnx
server/*.onnx.json

# Files generated while running the server or tests
server/results.csv
server/*.wav
!server/test_speech.wav

